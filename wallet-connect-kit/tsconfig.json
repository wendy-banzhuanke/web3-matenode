{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "declaration": true,         // 关键：生成 .d.ts
    "declarationMap": true, // 生成声明映射
    "emitDeclarationOnly": false, // *可选：仅生成类型文件
    "outDir": "dist",            // 输出目录
    "rootDir": "src",            // 源代码目录
    "composite": true, // 启用项目引用模式
    "noEmit": false,
    "skipLibCheck": true,
    // "skipLibCheck": false, // 严格类型检查
    "preserveSymlinks": true, // 防止模块解析混乱
    "verbatimModuleSyntax": true // 禁止无类型导入
  }
}